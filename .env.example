# Crea una frase casuale lunga almeno 32 caratteri.
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
SETUP_TOKEN=replace-with-a-one-time-setup-secret
CRON_SECRET=replace-with-a-random-cron-secret

